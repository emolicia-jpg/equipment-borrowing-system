<%- include('partials/header') %>

<h2>Borrowing Requests</h2>

<!-- Submit Request Form -->
<div class="card mb-4">
  <div class="card-header fw-bold">Submit Equipment Borrow Request</div>
  <div class="card-body">
    <form action="/requests/submit" method="POST" class="row g-3">
      <div class="col-md-3">
        <label>Select Equipment</label>
        <select name="equipment_id" class="form-select" required>
          <% equipmentList.forEach(item => { %>
            <option value="<%= item.id %>"><%= item.name %> (Available: <%= item.available_qty %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label>Quantity</label>
        <input type="number" name="quantity" min="1" value="1" class="form-control" required>
      </div>
      <div class="col-md-3">
        <label>Purpose</label>
        <input type="text" name="purpose" class="form-control" placeholder="Class activity, thesis..." required>
      </div>
      <div class="col-md-2">
        <label>Borrow Date</label>
        <input type="date" name="borrow_date" class="form-control" required>
      </div>
      <div class="col-md-2">
        <label>Return Date</label>
        <input type="date" name="return_date" class="form-control" required>
      </div>
      <div class="col-12 text-end">
        <button type="submit" class="btn btn-primary">Submit Request</button>
      </div>
    </form>
  </div>
</div>

<!-- Requests Table -->
<table class="table table-bordered table-striped bg-white shadow-sm">
  <thead class="table-dark">
    <tr>
      <th>Req ID</th>
      <th>Borrower</th>
      <th>Equipment</th>
      <th>Qty</th>
      <th>Purpose</th>
      <th>Borrow / Return Date</th>
      <th>Status</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% requests.forEach(reqItem => { %>
      <tr>
        <td><%= reqItem.id %></td>
        <td><%= reqItem.borrower_name %></td>
        <td><%= reqItem.equipment_name %></td>
        <td><%= reqItem.quantity %></td>
        <td><%= reqItem.purpose %></td>
        <td><%= reqItem.borrow_date %> to <%= reqItem.return_date %></td>
        <td>
          <span class="badge 
            <%= reqItem.status === 'Approved' || reqItem.status === 'Borrowed' ? 'bg-primary' : '' %>
            <%= reqItem.status === 'Returned' ? 'bg-success' : '' %>
            <%= reqItem.status === 'Pending' ? 'bg-warning text-dark' : '' %>
            <%= reqItem.status === 'Denied' ? 'bg-danger' : '' %>">
            <%= reqItem.status %>
          </span>
        </td>
        <td>
          <% if ((user.role === 'custodian' || user.role === 'admin') && reqItem.status === 'Pending') { %>
            <form action="/requests/approve/<%= reqItem.id %>" method="POST" class="d-inline">
              <button class="btn btn-sm btn-success">Approve & Release</button>
            </form>
          <% } else if ((user.role === 'custodian' || user.role === 'admin') && reqItem.status === 'Borrowed') { %>
            <form action="/requests/return/<%= reqItem.id %>" method="POST" class="d-inline">
              <input type="hidden" name="post_condition" value="Returned Good">
              <button class="btn btn-sm btn-info">Record Return</button>
            </form>
          <% } else { %>
            <small class="text-muted">None</small>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('partials/footer') %>