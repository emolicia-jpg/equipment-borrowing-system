<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Equipment Borrowing System - CSPC</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=8">
</head>
<body class="system-page">
  <% const activePath = typeof currentPath === 'string' ? currentPath : ''; %>
  <nav class="navbar navbar-expand-xxl navbar-dark system-navbar">
    <div class="container">
      <a class="navbar-brand fw-bold system-brand" href="/dashboard">
        <img class="system-logo" src="/images/cspc-logo.jpg" alt="CSPC logo">
        <span>CSPC Equipment System</span>
      </a>
      <% if (user) { %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#system-navigation" aria-controls="system-navigation" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="system-navigation">
          <div class="navbar-nav me-auto system-nav-links">
            <a class="nav-link <%= activePath === '/dashboard' ? 'active' : '' %>" href="/dashboard" <%= activePath === '/dashboard' ? 'aria-current="page"' : '' %>>Home</a>
            <a class="nav-link <%= activePath.startsWith('/equipment') ? 'active' : '' %>" href="/equipment" <%= activePath.startsWith('/equipment') ? 'aria-current="page"' : '' %>>Browse Equipment</a>
            <a class="nav-link <%= activePath.startsWith('/requests') ? 'active' : '' %>" href="/requests" <%= activePath.startsWith('/requests') ? 'aria-current="page"' : '' %>><%= user.role === 'student' || user.role === 'faculty' ? 'My Request' : 'Requests' %></a>
            <a class="nav-link <%= activePath.startsWith('/notifications') ? 'active' : '' %>" href="/notifications">Notifications</a>
            <% if (user.role === 'admin') { %>
              <a class="nav-link <%= activePath.startsWith('/admin') ? 'active' : '' %>" href="/admin">System Admin</a>
              <a class="nav-link <%= activePath.startsWith('/reports') ? 'active' : '' %>" href="/reports">Asset Reports</a>
            <% } else if (user.role === 'department_admin' || user.role === 'dean') { %>
              <a class="nav-link <%= activePath.startsWith('/reports') ? 'active' : '' %>" href="/reports">Asset Reports</a>
            <% } %>
          </div>
          <div class="system-user-menu">
            <div class="system-user-copy">
              <span class="system-user-name"><%= user.name %></span>
              <span class="system-user-role"><%= user.role === 'faculty' ? 'Instructor' : user.role %><%= user.departmentName ? ' - ' + user.departmentName : '' %></span>
            </div>
            <a class="btn btn-outline-light btn-sm system-logout" href="/auth/logout">Log out</a>
          </div>
        </div>
      <% } %>
    </div>
  </nav>
  <main class="container app-content">