<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - Equipment Borrowing System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page registration-page">
  <main class="container auth-container">
    <div class="row justify-content-center">
      <div class="col-md-5">
        <div class="card auth-card shadow">
          <div class="card-body">
            <div class="auth-brand">
              <img class="auth-logo" src="/images/cspc-logo.jpg" alt="CSPC logo">
              <h1 class="card-title text-center mb-4">Create an Account</h1>
            </div>
            <% if (error) { %>
              <div class="alert alert-danger"><%= error %></div>
            <% } %>
            <form action="/auth/register" method="POST">
              <div class="mb-3">
                <label for="name" class="form-label">Full Name</label>
                <input id="name" type="text" name="name" class="form-control" required>
              </div>
              <div class="mb-3">
                <label for="email" class="form-label">Email Address</label>
                <input id="email" type="email" name="email" class="form-control" placeholder="name@my.cspc.edu.ph" pattern="^[^\s@]+@my\.cspc\.edu\.ph$" title="Use your CSPC email ending in @my.cspc.edu.ph." autocomplete="username" required>
                <div class="form-text">Use your CSPC email address. The example clears as soon as you start typing.</div>
              </div>
              <div class="mb-3">
                <label for="department-id" class="form-label">College / Department</label>
                <select id="department-id" name="department_id" class="form-select" required>
                  <option value="">Choose your college</option>
                  <% departments.forEach(department => { %>
                    <option value="<%= department.id %>"><%= department.code %> - <%= department.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <div class="input-group password-toggle">
                  <input id="password" type="password" name="password" class="form-control" minlength="8" autocomplete="new-password" required>
                  <button class="btn btn-outline-secondary password-toggle-button" type="button" aria-label="Show password" aria-pressed="false" aria-controls="password" title="Show password">
                    <svg class="password-eye" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="password-eye-off" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.1 3.9M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10 10 0 0 0 3-.5"/></svg>
                  </button>
                </div>
              </div>
              <button type="submit" class="btn btn-primary w-100">Register</button>
            </form>
            <div class="text-center mt-3">
              <a href="/auth/login">Already have an account? Log in</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <script src="/js/password-toggle.js" defer></script>
</body>
</html>
