<%- include('partials/header') %>

<section class="page-heading">
  <span class="eyebrow">INVENTORY</span>
  <h1>Equipment</h1>
  <p>Browse items and see what is currently available to borrow.</p>
</section>

<% if (error) { %>
  <div class="alert alert-danger shadow-sm" role="alert"><%= error %></div>
<% } %>
<% if (success) { %>
  <div class="alert alert-success shadow-sm" role="status"><%= success %></div>
<% } %>

<% if (user.role === 'admin' || user.role === 'department_admin' || user.role === 'custodian') { %>
  <div class="card app-card mb-4">
    <div class="card-header app-card-header">
      <div>
        <span class="eyebrow">INVENTORY MANAGEMENT</span>
        <h2>Add equipment</h2>
      </div>
    </div>
    <div class="card-body">
      <form action="/equipment/add" method="POST" class="row g-3">
        <div class="col-md-<%= user.role === 'admin' ? '2' : '3' %>">
          <label for="equipment-name" class="visually-hidden">Item name</label>
          <input id="equipment-name" type="text" name="name" class="form-control" placeholder="Item name" required>
        </div>
        <div class="col-md-<%= user.role === 'admin' ? '2' : '3' %>">
          <label for="equipment-category" class="visually-hidden">Category</label>
          <input id="equipment-category" type="text" name="category" class="form-control" placeholder="Category" required>
        </div>
        <div class="col-md-<%= user.role === 'admin' ? '2' : '3' %>">
          <label for="equipment-quantity" class="visually-hidden">Quantity</label>
          <input id="equipment-quantity" type="number" name="total_qty" min="1" class="form-control" placeholder="Quantity" required>
        </div>
        <% if (user.role === 'admin') { %>
          <div class="col-md-3">
            <label for="equipment-department" class="visually-hidden">Department</label>
            <select id="equipment-department" name="department_id" class="form-select" required>
              <% departments.forEach(department => { %>
                <option value="<%= department.id %>"><%= department.code %></option>
              <% }) %>
            </select>
          </div>
        <% } %>
        <div class="col-md-<%= user.role === 'admin' ? '3' : '3' %>">
          <button type="submit" class="btn btn-primary w-100">Add item</button>
        </div>
      </form>
    </div>
  </div>
<% } %>

<div class="table-card">
  <div class="table-card-heading">
    <div>
      <span class="eyebrow">STOCK OVERVIEW</span>
      <h2>Equipment inventory</h2>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <label class="visually-hidden" for="equipment-search">Search equipment</label>
      <input id="equipment-search" type="search" class="form-control form-control-sm equipment-search" placeholder="Search equipment..." aria-controls="equipment-table">
      <span class="table-count"><%= equipment.length %> items</span>
    </div>
  </div>
<div class="table-responsive">
<table id="equipment-table" class="table app-table equipment-table <%= user.role === 'admin' || user.role === 'department_admin' || user.role === 'custodian' ? 'has-actions' : '' %> align-middle mb-0">
  <thead class="table-dark">
    <tr>
      <th scope="col">ID</th>
      <th scope="col">Equipment Name</th>
      <th scope="col">Category</th>
      <th scope="col">Department</th>
      <th scope="col">Total Quantity</th>
      <th scope="col">Available Quantity</th>
      <th scope="col">Condition</th>
      <th scope="col">Status</th>
      <% if (user.role === 'admin' || user.role === 'department_admin' || user.role === 'custodian') { %>
        <th scope="col">Actions</th>
      <% } %>
    </tr>
  </thead>
  <tbody>
    <% if (equipment.length === 0) { %>
      <tr class="equipment-empty-row">
        <td colspan="<%= user.role === 'admin' || user.role === 'department_admin' || user.role === 'custodian' ? 9 : 8 %>" class="table-empty-state">No equipment has been added yet.</td>
      </tr>
    <% } %>
    <% equipment.forEach(item => { %>
      <tr class="equipment-row">
        <td><%= item.id %></td>
        <td><%= item.name %></td>
        <td><%= item.category %></td>
        <td><%= item.department_code %></td>
        <td><%= item.total_qty %></td>
        <td>
          <span class="availability-pill <%= item.available_qty > 0 ? 'is-available' : 'is-unavailable' %>">
            <%= item.available_qty %>
          </span>
        </td>
        <td><%= item.condition %></td>
        <% const itemStatus = item.status === 'Maintenance' || item.status === 'Retired' ? item.status : Number(item.available_qty) < Number(item.total_qty) ? 'Borrowed' : 'Available'; %>
        <td>
          <span class="badge <%= itemStatus === 'Available' ? 'bg-success' : itemStatus === 'Borrowed' ? 'bg-warning text-dark' : 'bg-danger' %>"><%= itemStatus %></span>
        </td>
        <% if (user.role === 'admin' || user.role === 'department_admin' || user.role === 'custodian') { %>
          <td class="equipment-actions-cell">
            <form id="equipment-status-<%= item.id %>" action="/equipment/status/<%= item.id %>" method="POST" class="equipment-actions-form">
              <div class="equipment-status-fields">
                <select name="condition" class="form-select form-select-sm" aria-label="Condition for <%= item.name %>">
                  <option value="Good" <%= item.condition === 'Good' ? 'selected' : '' %>>Good</option>
                  <option value="Damaged" <%= item.condition === 'Damaged' ? 'selected' : '' %>>Damaged</option>
                </select>
                <select name="status" class="form-select form-select-sm" aria-label="Status for <%= item.name %>">
                  <option value="Available" <%= item.status === 'Available' ? 'selected' : '' %>>Available</option>
                  <option value="Maintenance" <%= item.status === 'Maintenance' ? 'selected' : '' %>>Maintenance</option>
                  <option value="Retired" <%= item.status === 'Retired' ? 'selected' : '' %>>Retired</option>
                </select>
              </div>
            </form>
            <div class="equipment-row-actions <%= user.role === 'admin' || user.role === 'department_admin' ? '' : 'single-action' %>">
              <button type="submit" form="equipment-status-<%= item.id %>" class="btn btn-outline-primary btn-sm">Save</button>
              <% if (user.role === 'admin' || user.role === 'department_admin') { %>
                <form action="/equipment/delete/<%= item.id %>" method="POST" onsubmit="return confirm('Delete this equipment item?');">
                  <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                </form>
              <% } %>
            </div>
          </td>
        <% } %>
      </tr>
    <% }) %>
    <tr id="equipment-no-results" hidden>
      <td colspan="<%= user.role === 'admin' || user.role === 'department_admin' || user.role === 'custodian' ? 9 : 8 %>" class="table-empty-state">No equipment matches your search.</td>
    </tr>
  </tbody>
</table>
</div>
</div>

<script>
  const equipmentSearch = document.getElementById('equipment-search');
  const equipmentRows = Array.from(document.querySelectorAll('.equipment-row'));
  const noEquipmentResults = document.getElementById('equipment-no-results');
  equipmentSearch.addEventListener('input', () => {
    const query = equipmentSearch.value.trim().toLocaleLowerCase();
    let visibleCount = 0;
    equipmentRows.forEach((row) => {
      const matches = row.textContent.toLocaleLowerCase().includes(query);
      row.hidden = !matches;
      if (matches) visibleCount += 1;
    });
    noEquipmentResults.hidden = visibleCount > 0 || equipmentRows.length === 0;
  });
</script>

<%- include('partials/footer') %>