<section class="dashboard-welcome">
  <div class="dashboard-welcome-copy">
    <span class="eyebrow">CSPC EQUIPMENT BORROWING SYSTEM</span>
    <h1>Welcome back, <%= user.name %></h1>
    <p>Manage equipment inventory and handle equipment releases and returns.</p>
    <span class="role-pill">Custodian account</span>
  </div>
  <div class="dashboard-mark" aria-hidden="true">
    <img src="/images/cspc-logo.jpg" alt="">
  </div>
</section>

<section class="dashboard-section" aria-labelledby="quick-actions-heading">
  <div class="section-heading">
    <div>
      <span class="eyebrow">CUSTODIAN SERVICES</span>
      <h2 id="quick-actions-heading">Manage equipment borrowing</h2>
    </div>
    <p>Review requests and keep the inventory up to date.</p>
  </div>
  <div class="row g-4">
    <div class="col-md-6">
      <a class="action-card" href="/equipment">
        <span class="action-icon equipment-icon" aria-hidden="true">01</span>
        <span class="action-card-copy">
          <strong>Manage equipment</strong>
          <span>Review the inventory and update equipment records.</span>
        </span>
        <span class="action-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
    <div class="col-md-6">
      <a class="action-card" href="/requests">
        <span class="action-icon request-icon" aria-hidden="true">02</span>
        <span class="action-card-copy">
          <strong>Manage borrowing requests</strong>
          <span>Release equipment and record returned items.</span>
        </span>
        <span class="action-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
